# Kopyala: cp .env.template .env
#
# --- Docker Compose ---
# DATABASE_URL yazma; POSTGRES_* ile compose otomatik oluşturur.
# Şifrede @ : / ? # gibi karakterler kullanma (URL kırılır).

POSTGRES_USER=vectordock
POSTGRES_PASSWORD=vectordock
POSTGRES_DB=vectordock
POSTGRES_PORT=5432
# POSTGRES_HEALTHCHECK_INTERVAL=5s
# POSTGRES_HEALTHCHECK_TIMEOUT=3s
# POSTGRES_HEALTHCHECK_RETRIES=3
REDIS_PORT=6379
# REDIS_HEALTHCHECK_INTERVAL=5s
# REDIS_HEALTHCHECK_TIMEOUT=2s
# REDIS_HEALTHCHECK_RETRIES=3
API_PORT=8000
WEB_PORT=3000

REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://host.docker.internal:3000

NEXT_PUBLIC_API_URL=http://localhost:8000

# OpenAI-compatible provider (NVIDIA Integrate)
OLLAMA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen/qwen3-coder-480b-a35b-instruct
# Eski Ollama kurulumu için: OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Sadece yerel venv (docker compose kullanmıyorsan) ---
# Aşağıdakileri aç; POSTGRES_* bu modda gerekmez.
# DATABASE_URL=postgresql://vectordock:vectordock@localhost:5432/vectordock
